import {
  "unmbt/moon-bump/internal/model",
  "moonbitlang/core/argparse",
  "moonbitlang/core/env",
  "mizchi/tui",
  "mizchi/tui/vnode",
  "mizchi/tui/render",
}

supported_targets = "native"

options(
  "pre-build": [
    {
      "input": "../../moon.mod",
      "output": "embedded_mod.mbt",
      "command": ":embed -i $input -o $output --name moon_mod",
    },
  ],
)
