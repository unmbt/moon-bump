import {
  "unmbt/moon-bump/internal/model",
  "moonbitlang/core/argparse",
  "moonbitlang/core/env",
  "mizchi/tui",
  "mizchi/tui/vnode",
  "mizchi/tui/render",
}

supported_targets = "native"

rule(
  name: "gen_version",
  command: "moon run scripts/gen_version.mbtx $input $output",
)

dev_build(
  rule: "gen_version",
  input: "../../moon.mod",
  output: "generated_version.mbt",
)
