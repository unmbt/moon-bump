import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "unmbt/moon-manifest@0.1.0" @manifest,
}

///|
async fn main {
  let args = @env.args()
  guard args is [_, input, output] else {
    fail("usage: gen_version.mbtx <moon.mod> <output.mbt>")
  }
  let source = @fs.read_file(input).text()
  let document = @manifest.parse(@manifest.Kind::Mod, source, path=input)
  guard document.diagnostics.is_empty() else {
    fail(document.diagnostics[0].message)
  }
  guard document.version() is Some(version) else {
    fail("missing version in " + input)
  }
  let generated = "// Generated by unmbt/moon-manifest. DO NOT EDIT.\n\n///|\n" +
    "const VERSION = " + Json::string(version).stringify() + "\n"
  let destination = @fs.realpath(".") + "/" + output
  if !@fs.exists(destination) || @fs.read_file(destination).text() != generated {
    @fs.write_file(destination, generated)
  }
}
