import {
  "moonbitlang/x/fs" @fs,
  "moonbitlang/core/env" @env,
}

fn main {
  let args = @env.args()
  if args.length() < 3 {
    println("Usage: moon run scripts/gen_version.mbtx <input> <output>")
    return
  }
  let input_path = args[1]
  let output_path = args[2]
  let content = try {
    @fs.read_file_to_string(input_path)
  } catch {
    error => {
      println("Failed to read input file '\{input_path}': \{Repr(error)}")
      return
    }
  }
  let output_content = "// Generated by scripts/gen_version.mbtx, do not edit.\n\n///|\nlet moon_mod : String =\n  #|" +
    content.replace_all(old="\r\n", new="\n").replace_all(old="\n", new="\n  #|") +
    "\n"
  try {
    @fs.write_string_to_file(output_path, output_content)
  } catch {
    error => {
      println("Failed to write output file '\{output_path}': \{Repr(error)}")
      return
    }
  }
}
