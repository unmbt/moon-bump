import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/async@0.21.3/fs",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}

///|
async fn main {
  let args = @env.args()
  guard args.length() == 3 else {
    fail("usage: gen_version.mbtx <moon.mod> <output.mbt>")
  }
  let manifest = @fs.read_file(args[1]).text()
  let mut version : String? = None
  for line in manifest.split("\n") {
    guard line.find("=") is Some(eq) else { continue }
    guard line[:eq].trim() == "version" else { continue }
    guard version is None else { fail("duplicate version in moon.mod") }
    guard @json.parse(line[eq + 1:].trim().to_owned()) is String(value) &&
      !value.is_empty() else {
      fail("moon.mod version must be a nonempty string")
    }
    version = Some(value)
  }
  guard version is Some(version) else { fail("missing version in moon.mod") }
  let literal = Json::string(version).stringify()
  let generated =
    $|// Generated by tools/gen_version.mbtx from moon.mod. Do not edit.
    $|
    $|///|
    $|const VERSION = \{literal}
    $|
  if !@fs.exists(args[2]) || @fs.read_file(args[2]).text() != generated {
    @fs.write_file(args[2], generated)
  }
}
